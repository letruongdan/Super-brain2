    "KernelHttpCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments", "correlation_id", "selected_scope"],
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "prepare_task",
            "search_knowledge",
            "get_artifact",
            "submit_episode",
            "record_outcome",
            "request_improvement",
            "get_job",
            "get_health"
          ]
        },
        "arguments": {"type": "object"},
        "correlation_id": {
          "anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 128},
            {"type": "null"}
          ]
        },
        "selected_scope": {
          "anyOf": [
            {"$ref": "#/$defs/Scope"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"tool": {"const": "prepare_task"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/PrepareTaskDaemonArgs"}}
          }
        },
        {
          "if": {
            "properties": {"tool": {"const": "search_knowledge"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/SearchKnowledgeDaemonArgs"}}
          }
        },
        {
          "if": {
            "properties": {"tool": {"const": "get_artifact"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/GetArtifactDaemonArgs"}}
          }
        },
        {
          "if": {
            "properties": {"tool": {"const": "submit_episode"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/SubmitEpisodeDaemonArgs"}}
          }
        },
        {
          "if": {
            "properties": {"tool": {"const": "record_outcome"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/RecordOutcomeDaemonArgs"}}
          }
        },
        {
          "if": {
            "properties": {"tool": {"const": "request_improvement"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/RequestImprovementDaemonArgs"}}
          }
        },
        {
          "if": {
            "properties": {"tool": {"const": "get_job"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/GetJobDaemonArgs"}}
          }
        },
        {
          "if": {
            "properties": {"tool": {"const": "get_health"}},
            "required": ["tool"]
          },
          "then": {
            "properties": {"arguments": {"$ref": "#/$defs/GetHealthDaemonArgs"}}
          }
        }
      ]
    }
  }
